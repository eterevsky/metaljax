+namespace {
+
+// The layout of `array::Data::pins` (array.h).
+constexpr uint64_t kPinsMask = 0xFFull;
+constexpr int kGenPinsShift = 8;
+constexpr uint64_t kGenPinsMask = 0xFFull << kGenPinsShift;
+constexpr int kGenShift = 16;
+constexpr uint64_t kGenMask = 0xFFFFFFFFull << kGenShift;
+constexpr int kStreamShift = 48;
+constexpr int64_t kStreamNone = -1;
+constexpr int64_t kStreamMixed = -2;
+
+inline int64_t pins_stream(uint64_t w) {
+  return static_cast<int16_t>(static_cast<uint16_t>(w >> kStreamShift));
+}
+inline uint64_t pack(int64_t stream, uint32_t gen, uint32_t gen_pins,
+                     uint32_t pins) {
+  return (static_cast<uint64_t>(static_cast<uint16_t>(static_cast<int16_t>(stream)))
+          << kStreamShift) |
+      (static_cast<uint64_t>(gen) << kGenShift) |
+      (static_cast<uint64_t>(gen_pins & 0xFF) << kGenPinsShift) |
+      static_cast<uint64_t>(pins & 0xFF);
+}
+
+} // namespace
+
+void pin_data(std::atomic<uint64_t>& pins, int stream, uint32_t gen) {
+  uint64_t old = pins.load(std::memory_order_relaxed);
+  for (;;) {
+    const uint32_t n = static_cast<uint32_t>(old & kPinsMask);
+    const uint32_t ng = static_cast<uint32_t>((old & kGenPinsMask) >> kGenPinsShift);
+    const uint32_t g = static_cast<uint32_t>((old & kGenMask) >> kGenShift);
+    const int64_t s = pins_stream(old);
+    uint64_t next;
+    if (n == 0) {
+      next = pack(stream, gen, 1, 1);
+    } else if (n >= 255 || s == kStreamMixed || s != stream) {
+      // Several streams, or more encoders than the word can count: the
+      // strict test from here on until every pin is gone.
+      next = pack(kStreamMixed, 0, 0, std::min<uint32_t>(n + 1, 255));
+    } else if (g == gen) {
+      next = pack(stream, gen, ng + 1, n + 1);
+    } else {
+      next = pack(stream, gen, 1, n + 1);
+    }
+    if (pins.compare_exchange_weak(
+            old, next, std::memory_order_release, std::memory_order_relaxed)) {
+      return;
+    }
+  }
+}
+
+void unpin_data(std::atomic<uint64_t>& pins) {
+  uint64_t old = pins.load(std::memory_order_relaxed);
+  for (;;) {
+    const uint32_t n = static_cast<uint32_t>(old & kPinsMask);
+    uint64_t next;
+    if (n <= 1) {
+      next = array::Data::kNoPins;
+    } else {
+      // A pin that completes belongs to an encoder that has ended, never
+      // to the open generation, so only the total moves.  (When the word
+      // saturated at 255 the count is a floor; it still reaches zero,
+      // because every pin that was counted is released.)
+      next = (old & ~kPinsMask) | static_cast<uint64_t>(n - 1);
+    }
+    if (pins.compare_exchange_weak(
+            old, next, std::memory_order_release, std::memory_order_relaxed)) {
+      return;
+    }
+  }
+}
+
+} // namespace detail
+
+bool array::is_donatable(bool through_stream_pins) const {
+  if (array_desc_.use_count() != 1) {
+    return false;
+  }
+  const long holders = array_desc_->data.use_count();
+  if (holders == 1) {
+    return true;
+  }
+  if (!through_stream_pins) {
+    return false;
+  }
+  const detail::EvalContext& ctx = detail::eval_context();
+  if (ctx.stream < 0) {
+    return false;
+  }
+  // The word before the holder count: a pin is released (unpin) BEFORE its
+  // shared_ptr<Data> is dropped, and taken AFTER it is copied, so a reader
+  // that sees the word sees at least as many holders -- any skew between
+  // the two reads only ever makes the equality below fail.
+  const uint64_t w = array_desc_->data->pins.load(std::memory_order_acquire);
+  if (detail::pins_stream(w) != ctx.stream) {
+    return false;
+  }
+  const long pins = static_cast<long>(w & detail::kPinsMask);
+  if (holders != 1 + pins) {
+    return false; // a view, a temporary, another array: a real observer
+  }
+  const uint32_t g = static_cast<uint32_t>((w & detail::kGenMask) >> detail::kGenShift);
+  const long open = (g == ctx.gen)
+      ? static_cast<long>((w & detail::kGenPinsMask) >> detail::kGenPinsShift)
+      : 0;
+  if (pins > open) {
+    // Some of those reads were encoded by encoders that have ended (still
+    // in flight, or done): the backend must order this encoder after them.
+    detail::eval_context().inflight_donation = true;
+  }
+  return true;
+}
+
 array::array(const std::complex<float>& val, Dtype dtype /* = complex64 */)
     : array_desc_(std::make_shared<ArrayDesc>(Shape{}, dtype)) {
   auto cval = static_cast<complex64_t>(val);
