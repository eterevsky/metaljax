From 87c8ea34db0f848853284e273530799eea5720f1 Mon Sep 17 00:00:00 2001
From: Oleg Eterevsky <oleg@eterevsky.com>
Date: Mon, 17 Aug 2026 22:25:33 +0200
Subject: [PATCH 2/2] diag: trace primitive names at MLX_SPLIT_DEBUG>=3

Lets a canary log say which primitive owns the temporary whose fence wait
end_encoding() dropped.
---
 mlx/backend/metal/device.cpp | 2 +-
 mlx/backend/metal/device.h   | 3 +++
 mlx/backend/metal/eval.cpp   | 7 +++++++
 3 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/mlx/backend/metal/device.cpp b/mlx/backend/metal/device.cpp
index dc8c1aa1..c48c4ca1 100644
--- a/mlx/backend/metal/device.cpp
+++ b/mlx/backend/metal/device.cpp
@@ -307,7 +307,7 @@ MTL::Library* load_library(
 // encoder boundary with the fence bookkeeping it performed and the waits it
 // dropped (=2 also prints one line per dropped wait).  Off by default, read
 // once.
-static int split_debug() {
+int split_debug() {
   static int level = env::get_var("MLX_SPLIT_DEBUG", 0);
   return level;
 }
diff --git a/mlx/backend/metal/device.h b/mlx/backend/metal/device.h
index b13f7499..326d7e78 100644
--- a/mlx/backend/metal/device.h
+++ b/mlx/backend/metal/device.h
@@ -250,6 +250,9 @@ class MLX_API Device {
   int max_mb_per_buffer_;
 };
 
+// DIAGNOSTIC ONLY (MLX_SPLIT_DEBUG level).
+int split_debug();
+
 MLX_API Device& device(mlx::core::Device);
 MLX_API CommandEncoder& get_command_encoder(Stream s);
 
diff --git a/mlx/backend/metal/eval.cpp b/mlx/backend/metal/eval.cpp
index e6826253..4dad44ed 100644
--- a/mlx/backend/metal/eval.cpp
+++ b/mlx/backend/metal/eval.cpp
@@ -42,6 +42,13 @@ void eval(array& arr) {
     }
 
     debug_set_primitive_buffer_label(command_buffer, arr.primitive());
+    if (metal::split_debug() > 2) {
+      fprintf(
+          stderr,
+          "[mlx-split]   prim=%s size=%zu\n",
+          arr.primitive().name(),
+          static_cast<size_t>(arr.size()));
+    }
     arr.primitive().eval_gpu(arr.inputs(), outputs);
   }
   std::unordered_set<std::shared_ptr<array::Data>> buffers;
-- 
