index d686c297..ed2f79d3 100644
--- a/mlx/backend/metal/metal.h
+++ b/mlx/backend/metal/metal.h
@@ -2,6 +2,7 @@
 
 #pragma once
 
+#include <cstdint>
 #include <string>
 #include <unordered_map>
 #include <variant>
@@ -27,4 +28,44 @@ MLX_API const
 MLX_API void set_metallib_path(const std::string& path);
 MLX_API const std::string& get_metallib_path();
 
+/** Process-wide dispatch and command-buffer accounting (diagnostic).
+ *
+ * Every compute dispatch the Metal backend encodes goes through
+ * `CommandEncoder::dispatch_threads` / `dispatch_threadgroups` and every
+ * command buffer through `CommandEncoder::commit`, so these counters are
+ * exact for the work the GPU was handed.  They are cumulative since
+ * process start: take two snapshots and subtract.  `dispatches` is
+ * accumulated at commit time (the encoder already keeps the per-buffer
+ * count for its commit cadence), so a snapshot lags the open command
+ * buffer by at most one buffer's worth of dispatches; at any blocking
+ * eval it is exact.
+ *
+ * The GPU fields come from `MTLCommandBuffer` timestamps read in the
+ * completion handlers, so a snapshot taken right after a blocking eval
+ * can still miss the last buffer: compare `completed_command_buffers`
+ * with `command_buffers`.  Spans from different queues can overlap, which
+ * is why both the plain sum (`gpu_busy_ns`) and the merged occupancy
+ * (`gpu_span_ns`) are kept; `gpu_gap_ns` is the idle time between one
+ * buffer's GPU end and the next buffer's GPU start.
+ *
+ * All times are nanoseconds on the host's CLOCK_UPTIME_RAW base -- the
+ * base `GPUStartTime` / `GPUEndTime` report -- so `now_ns` from two
+ * snapshots gives the wall time of the window they bracket.
+ *
+ * Set MLX_DISPATCH_TRACE=1 to also print one line per command buffer as
+ * it completes.
+ */
+struct DispatchStats {
+  uint64_t dispatches = 0; // compute dispatches committed
+  uint64_t command_buffers = 0; // command buffers committed
+  uint64_t empty_command_buffers = 0; // ...of which carried no dispatch
+  uint64_t completed_command_buffers = 0; // ...whose completion handler ran
+  uint64_t gpu_busy_ns = 0; // sum over completed buffers of end - start
+  uint64_t gpu_span_ns = 0; // the same with overlapping buffers merged
+  uint64_t gpu_gap_ns = 0; // idle between consecutive buffers on the GPU
+  uint64_t queue_ns = 0; // sum of GPU start - host commit time
+  uint64_t now_ns = 0; // host clock when the snapshot was taken
+};
+MLX_API DispatchStats dispatch_stats();
+
 } // namespace mlx::core::metal
diff --git a/mlx/backend/metal/no_metal.cpp b/mlx/backend/metal/no_metal.cpp
index 3b72ad00..d69b0bb0 100644
--- a/mlx/backend/metal/no_metal.cpp
+++ b/mlx/backend/metal/no_metal.cpp
@@ -23,6 +23,10 @@ device_info() {
 
 void set_metallib_path(const std::string& path) {}
 
+DispatchStats dispatch_stats() {
+  return {};
+}
+
 const std::string& get_metallib_path() {
   throw std::runtime_error(
       "[metal::get_metallib_path] Cannot get metallib path without metal backend");
