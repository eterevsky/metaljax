# metaljax native PJRT plugin build configuration.
#
# Most of this is XLA's own configuration: we import xla/tensorflow.bazelrc
# verbatim (absolute path, because %workspace% would resolve to *this*
# workspace) and then re-add the handful of flags that live in xla/.bazelrc
# itself plus the macOS toolchain selection that jax's .bazelrc contributes.

# --- from xla/.bazelrc -------------------------------------------------------
# We build XLA in WORKSPACE mode.  Bazel 8 defaults the other way, and XLA at
# this pin (91888df6) now does too: its .bazelrc gates WORKSPACE mode behind
# `--config=workspace`, which sets exactly these two flags.  We do not import
# xla/.bazelrc, so set them here unconditionally (no --config needed).
common --noenable_bzlmod --enable_workspace

# Turn off empty glob check (flipped in Bazel 8).
common --incompatible_disallow_empty_glob=false

# Enable legacy external runfiles (false in Bazel 8, breaks XLA targets).
common --legacy_external_runfiles=true

common --incompatible_enable_cc_toolchain_resolution
common --repo_env USE_HERMETIC_CC_TOOLCHAIN=1

# Non-hermetic (system clang) toolchain; the only thing that works on Darwin.
common:clang_local --noincompatible_enable_cc_toolchain_resolution
common:clang_local --@rules_ml_toolchain//common:enable_hermetic_cc=False
common:clang_local --repo_env USE_HERMETIC_CC_TOOLCHAIN=0

# --- XLA's shared TF configuration ------------------------------------------
import /Users/oleg/metaljax/xla-91888df6/tensorflow.bazelrc

# tensorflow.bazelrc at this pin (new since 131bf41) sets
# `--experimental_downloader_config=bazel_downloader.cfg` for build / test /
# fetch / sync / query -- a RELATIVE path, which bazel resolves against the
# workspace root, i.e. against plugin-native/, where no such file exists.
# Re-point it at XLA's own copy (absolute, like the import above) rather than
# copying the file in: the mirror list then moves with the pin instead of
# going stale here.  Per-command lines, because a `common` line would be
# overridden by tensorflow.bazelrc's per-command ones.
build --experimental_downloader_config=/Users/oleg/metaljax/xla-91888df6/bazel_downloader.cfg
test --experimental_downloader_config=/Users/oleg/metaljax/xla-91888df6/bazel_downloader.cfg
fetch --experimental_downloader_config=/Users/oleg/metaljax/xla-91888df6/bazel_downloader.cfg
sync --experimental_downloader_config=/Users/oleg/metaljax/xla-91888df6/bazel_downloader.cfg
query --experimental_downloader_config=/Users/oleg/metaljax/xla-91888df6/bazel_downloader.cfg

# --- macOS toolchain (from jax/.bazelrc) ------------------------------------
# tensorflow.bazelrc sets --apple_crosstool_top etc. for :macos, but selecting
# the local clang toolchain is jax's addition and is what makes an out-of-tree
# Darwin build work.
common:macos --config=clang_local

# --- local conveniences ------------------------------------------------------
# Pin the action environment's PATH to a fixed value instead of inheriting the
# client's.  Without this, `uv build` (which is how the wheel is produced --
# see hatch_build.py) misses the cache *completely*: uv prepends a fresh
# per-invocation temp venv to PATH (~/.cache/uv/builds-v0/.tmpXXXXXX/bin), so
# every wheel build had different action keys and recompiled all ~5,200
# actions, 5.5 minutes, for byte-identical outputs.  With it, wheel builds and
# plain `bazel build` share one cache and a wheel relink is seconds.
build --incompatible_strict_action_env
build --disk_cache=~/.cache/metaljax-bazel
build --verbose_failures
common --announce_rc

try-import %workspace%/.bazelrc.user
