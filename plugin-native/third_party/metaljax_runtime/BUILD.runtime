# The metaljax executor runtime (metaljax/native) as a plain cc_library.
#
# These are the SAME sources native/build.sh compiles into the nanobind
# extension -- not a copy.  The repository is a `new_local_repository` over
# ../native (WORKSPACE), so an edit there is picked up here on the next build
# and the two builds can never drift.  What makes that possible is that
# `program.h` and everything under it name no Python: the two nanobind
# translation units (`bindings.cc`, `metaljax_native.cc`) are deliberately
# ABSENT from `srcs` below, and adding one would break this build immediately.
#
# `srcs` is spelled out rather than globbed on purpose.  A glob would sweep in
# those two, and it would sweep in `build/` (the extension's output directory,
# which lives inside the source tree).  The order is native/build.sh's.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

cc_library(
    name = "runtime",
    srcs = [
        "compile.cc",
        "config.cc",
        "control.cc",
        "dtypes.cc",
        "emits.cc",
        "host.cc",
        "msl.cc",
        "ops_conv.cc",
        "ops_elementwise.cc",
        "ops_index.cc",
        "ops_linalg.cc",
        "ops_reduce.cc",
        "ops_rng.cc",
        "ops_shape.cc",
        "program.cc",
        "runtime.cc",
    ],
    hdrs = [
        "msl.h",
        "program.h",
    ],
    copts = [
        # MLX's half/bfloat16 headers declare a copy constructor without a
        # copy assignment and default the comparison operators; both are
        # noisy under XLA's warning set and neither is ours to fix.
        "-Wno-deprecated-copy",
        "-Wno-c++20-extensions",
    ],
    # `//metal:libmetal_pjrt_native.dylib` does not call into the tape yet
    # (the plugin's CompileAndLoad still returns Unimplemented), so without
    # this the linker would drop every object and prove nothing.  Forcing
    # them in is the point: it is what makes a symbol collision between the
    # runtime, libmlx and XLA's statically-linked LLVM/absl a build failure
    # here rather than a mystery in phase 2.
    alwayslink = 1,
    deps = ["@mlx"],
)
